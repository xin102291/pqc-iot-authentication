# 複製成 .env 並填入自己的值；.env 已在 .gitignore 中，不會被提交

# Web/（Flask + SQLAlchemy）：mysql+pymysql://使用者:密碼@主機/資料庫
DATABASE_URL=mysql+pymysql://pqc:your_password@localhost/server

# IoT/Server.py（mysql-connector）
DB_HOST=localhost
DB_USER=pqc
DB_PASSWORD=
DB_NAME=server

# IoT/Server.py 收到的感測資料要寫入哪位病患（示範資料為 A123456789）
IOT_PATIENT_ID=A123456789
